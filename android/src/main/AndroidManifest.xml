<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.example.ussd_handler">
  
  <!-- Permissions required to execute USSD codes -->
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-feature android:name="android.hardware.telephony" android:required="false" />
  
  <!-- Permissions for accessibility services -->
  <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
  
  <application>
    <!-- Accessibility service to capture USSD responses -->
    <service android:name="com.example.ussd_handler.UssdAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="false"
      android:label="@string/ussd_accessibility_service_label">
      <intent-filter>
          <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
    </service>
    
    <!-- Activity for accessibility configuration -->
    <activity
      android:name="com.example.ussd_handler.UssdAccessibilitySettingsActivity"
      android:exported="false"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
  </application>
</manifest>
